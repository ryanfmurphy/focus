<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.murftown.focus</string>

    <key>ProgramArguments</key>
    <array>
        <string>__FOCUS_BIN__</string>
    </array>

    <!-- Launch at login and keep it alive if it ever exits/crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- An Aqua GUI session is required to show modals. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardErrorPath</key>
    <string>/tmp/focus.err.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/focus.out.log</string>
</dict>
</plist>
