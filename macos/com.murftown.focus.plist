<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.murftown.focus</string>

    <!-- __FOCUS_BIN__ is substituted with the built binary's absolute path by
         install.sh (launchd requires an absolute path, so it's filled in per machine). -->
    <key>ProgramArguments</key>
    <array>
        <string>__FOCUS_BIN__</string>
    </array>

    <!-- Launch at login, and relaunch only if it exits *unsuccessfully* (a crash
         or kill). A clean quit (Cmd-Q / "Quit focus", exit 0) stays closed until
         the next login or an explicit relaunch (./open.sh). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <!-- An Aqua GUI session is required to show modals. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>StandardErrorPath</key>
    <string>/tmp/focus.err.log</string>
    <key>StandardOutPath</key>
    <string>/tmp/focus.out.log</string>
</dict>
</plist>
